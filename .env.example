# --- Infrastructure (Postgres 17 + Redis 7, provided externally) ---
DATABASE_URL=postgres://user:password@localhost:5432/ig_watch
# DATABASE_SSL=false
REDIS_URL=redis://localhost:6379/0

# --- Instagram / Meta ---
# Numeric Instagram business account id that performs business_discovery
IG_USER_ID=17841400000000000
# Long-lived user token (60 days). Only used on first start; afterwards the DB copy is refreshed automatically.
IG_ACCESS_TOKEN=
FB_APP_ID=
FB_APP_SECRET=
GRAPH_API_VERSION=v21.0

# --- Telegram notifications (optional) ---
# Bot token from @BotFather. Recipient chats are managed in the panel (Bildirimler).
TELEGRAM_BOT_TOKEN=

# --- Panel ---
PANEL_PASSWORD=change-me
# Optional; defaults to a value derived from PANEL_PASSWORD
# SESSION_SECRET=
# Set true only if the panel is served over HTTPS
# COOKIE_SECURE=false
PORT=3000

# --- Deploy (docker-compose.yml) ---
# Bind the panel to the server's Tailscale IP so it is reachable only over Tailscale
# WEB_BIND=100.x.y.z
# WEB_PORT=18473
# Pin a released image (docker-compose.prod.yml), e.g. sha-d64059a; default latest
# IMAGE_TAG=

# --- Optional ---
# OCR_CONCURRENCY=1
# TESSERACT_CACHE_DIR=./.tesseract-cache
